} else {
data <- read_excel(file_path, sheet = sheet_name)
}
return(data)
}
# Function to extract bold cells from an Excel sheet
extract_bold_cells <- function(file_path, sheet_name) {
cells <- xlsx_cells(file_path, sheets = sheet_name)
formats <- xlsx_formats(file_path)
bold_cells <- cells %>%
filter(!is_blank) %>%
mutate(is_bold = map_lgl(local_format_id, ~ formats$local$font$bold[.x + 1] %||% FALSE)) %>%
filter(is_bold) %>%
select(row, col, character)
return(bold_cells)
}
# Function to mark bold cells in the dataframe
mark_bold_cells_in_df <- function(data, bold_cells) {
data <- data %>%
mutate(across(everything(), ~ ifelse(paste(row_number(), cur_column(), sep = "_") %in% paste(bold_cells$row, bold_cells$col, sep = "_"), paste0(.x, "#"), .x)))
return(data)
}
# Function to remove irrelevant columns
remove_irrelevant_columns <- function(data) {
relevant_columns <- grep("pathway|gene", names(data), ignore.case = TRUE, value = TRUE)
data <- data %>% select(all_of(relevant_columns))
return(data)
}
# Function to extract positive and negative gene lists by row
extract_gene_lists <- function(data) {
positive_genes <- list()
negative_genes <- list()
for (i in seq_len(nrow(data))) {
pathway <- as.character(data[i, 1])
pathway <- sub("#$", "", pathway)
genes <- data[i, -1]
pos_genes <- genes[!is.na(genes) & grepl("#$", genes)]
neg_genes <- genes[!is.na(genes) & !grepl("#$", genes)]
positive_genes[[pathway]] <- sub("#$", "", pos_genes)
negative_genes[[pathway]] <- neg_genes
}
return(list(positive_genes = positive_genes, negative_genes = negative_genes))
}
# Ensure directory exists or create it
ensure_dir_exists <- function(dir_path) {
if (!dir.exists(dir_path)) {
dir.create(dir_path, recursive = TRUE)
}
}
# Define directory paths
input_directory_path <- "D:/pathway_project/test"
output_directory_path <- "D:/pathway_project/output"
# Ensure output directory exists
ensure_dir_exists(output_directory_path)
# Get a list of all Excel files in the input directory
file_list <- list.files(input_directory_path, pattern = "\\.xlsx$", full.names = TRUE)
# Initialize lists to store the results
positive_genes_all <- list()
negative_genes_all <- list()
# Process each file in the directory
for (file_path in file_list) {
sheet_name <- "Sheet1"
data <- read_excel_to_df(file_path, sheet_name)
data <- remove_irrelevant_columns(data)
bold_cells <- extract_bold_cells(file_path, sheet_name)
write.csv(bold_cells, file.path(output_directory_path, paste0("bold_cells_", basename(file_path), ".csv")), row.names = FALSE)
data <- mark_bold_cells_in_df(data, bold_cells)
gene_lists <- extract_gene_lists(data)
positive_genes <- gene_lists$positive_genes
negative_genes <- gene_lists$negative_genes
for (pathway in union(names(positive_genes), names(negative_genes))) {
if (!is.null(positive_genes[[pathway]])) {
positive_genes_all[[pathway]] <- unique(c(positive_genes_all[[pathway]], positive_genes[[pathway]]))
}
if (!is.null(negative_genes[[pathway]])) {
negative_genes_all[[pathway]] <- unique(c(negative_genes_all[[pathway]], negative_genes[[pathway]]))
}
}
}
pos_dir <- file.path(output_directory_path, "positive_genes")
neg_dir <- file.path(output_directory_path, "negative_genes")
ensure_dir_exists(pos_dir)
ensure_dir_exists(neg_dir)
# Save the positive and negative gene lists to CSV files
for (pathway in names(positive_genes_all)) {
sanitized_pathway <- sanitize_filename(pathway)
write.csv(positive_genes_all[[pathway]], file.path(pos_dir, paste0(sanitized_pathway, ".csv")), row.names = FALSE)
write.csv(negative_genes_all[[pathway]], file.path(neg_dir, paste0(sanitized_pathway, ".csv")), row.names = FALSE)
}
# Prepare the final dataframe
results_df <- data.frame(
Pathway = names(positive_genes_all),
Positive_Genes = sapply(positive_genes_all, function(x) paste(x, collapse = ", ")),
Negative_Genes = sapply(negative_genes_all, function(x) paste(x, collapse = ", ")),
stringsAsFactors = FALSE
)
library(writexl)
install.packages("writexl")
library(writexl)
# Define the output path
compiled_results_path <- file.path(output_directory_path, "compiled_gene_lists.xlsx")
# Write the data frame to an Excel file
write_xlsx(results_df, compiled_results_path)
# Print the compiled results
print("Compiled Results DataFrame:")
print(results_df)
